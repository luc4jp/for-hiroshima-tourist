---
interface Props {
  url: string;
  title: string;
  description?: string;
  image?: string;
}

const { url, title, description, image } = Astro.props;

let domain = '';
let faviconUrl = '';
try {
  const parsed = new URL(url);
  domain = parsed.hostname.replace(/^www\./, '');
  faviconUrl = `https://www.google.com/s2/favicons?domain=${domain}&sz=32`;
} catch (e) {
  domain = url;
}
---

<a href={url} target="_blank" rel="noopener noreferrer" class="notion-bookmark-card not-content">
  <div class="bookmark-info">
    <div class="bookmark-title">{title}</div>
    {description && <div class="bookmark-desc">{description}</div>}
    <div class="bookmark-meta">
      {faviconUrl && <img src={faviconUrl} alt="" class="bookmark-favicon" width="14" height="14" loading="lazy" />}
      <span class="bookmark-domain">{domain}</span>
    </div>
  </div>
  {image && (
    <div class="bookmark-thumbnail">
      <img src={image} alt={title} loading="lazy" />
    </div>
  )}
</a>

<style>
  .notion-bookmark-card {
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
    text-decoration: none;
    margin: 1rem 0;
    background-color: var(--sl-color-gray-6);
    transition: border-color 0.15s ease, background-color 0.15s ease;
    min-height: 5rem;
  }
  .notion-bookmark-card:hover {
    border-color: var(--sl-color-gray-3);
    background-color: var(--sl-color-gray-5);
  }
  .bookmark-info {
    flex: 1;
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    min-width: 0;
  }
  .bookmark-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--sl-color-white);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }
  .bookmark-desc {
    font-size: 0.8rem;
    color: var(--sl-color-gray-2);
    margin-top: 0.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.4;
  }
  .bookmark-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }
  .bookmark-favicon {
    width: 14px;
    height: 14px;
    border-radius: 2px;
  }
  .bookmark-domain {
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }
  .bookmark-thumbnail {
    width: 160px;
    min-width: 120px;
    max-width: 200px;
    background-color: var(--sl-color-gray-5);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bookmark-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 500px) {
    .bookmark-thumbnail {
      width: 100px;
      min-width: 80px;
    }
  }
</style>
